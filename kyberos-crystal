#!/usr/bin/env bash
# kyberos-crystal <blue|green|red|purple|yellow|white> [--quiet]
# Re-tunes every KyberOS piece in this session to one kyber crystal colour.
# (Boot splash + login greeter: re-run install.sh --crystal X --system.)
set -euo pipefail

crystal=${1:-}
quiet=0
[ "${2:-}" = --quiet ] && quiet=1
declare -A HEX=([blue]="#33b5ff" [green]="#3ef08a" [red]="#ff2d3f" [purple]="#b264ff" [yellow]="#ffd23c" [white]="#e2f4ff")
if [ -z "$crystal" ] || [ -z "${HEX[$crystal]:-}" ]; then
    echo "usage: kyberos-crystal <blue|green|red|purple|yellow|white>" >&2
    exit 2
fi
Cap=${crystal^}
hex=${HEX[$crystal]}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$DATA/kyberos"
echo "$crystal" > "$DATA/kyberos/crystal"

# ---- Cinnamon ----
desktop=${KYBEROS_DESKTOP:-}
[ -n "$desktop" ] || case "${XDG_CURRENT_DESKTOP:-}" in *Cinnamon*) desktop=cinnamon ;; *KDE*|*Plasma*) desktop=plasma ;; esac
[ -n "$desktop" ] || { pgrep -u "$(id -u)" -x cinnamon >/dev/null && desktop=cinnamon || desktop=plasma; }
if [ "$desktop" = cinnamon ]; then
    cp=""; for c in $(pgrep -u "$(id -u)" -x cinnamon); do [ -r "/proc/$c/environ" ] && { cp=$c; break; }; done   # skip zombies
    [ -n "$cp" ] && while IFS= read -r -d '' kv; do
        name=${kv%%=*}
        case $name in DISPLAY|XAUTHORITY|DBUS_SESSION_BUS_ADDRESS) [ -z "${!name:-}" ] && export "$kv" ;; esac
    done < "/proc/$cp/environ"
    gsettings set org.cinnamon.desktop.interface gtk-theme "KyberOS-$Cap"
    gsettings set org.cinnamon.desktop.wm.preferences theme "KyberOS-$Cap"
    gsettings set org.cinnamon.theme name "KyberOS-$Cap"
    gsettings set org.cinnamon.desktop.interface cursor-theme "KyberOS-$Cap"
    gsettings set org.gnome.desktop.interface cursor-theme "KyberOS-$Cap" 2>/dev/null || true
    # GTK 4 / libadwaita overrides follow the crystal
    g=${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0
    for f in gtk.css gtk-dark.css assets; do
        [ -L "$g/$f" ] && ln -sfn "$DATA/themes/KyberOS-$Cap/gtk-4.0/$f" "$g/$f"
    done
    # terminal palette
    uuid=$(gsettings get org.gnome.Terminal.ProfilesList list 2>/dev/null | grep -o "6b796265-726f-4f53-8000-00000000000a" || true)
    f=$DATA/kyberos/gnome-terminal/KyberOS$Cap.dconf
    [ -n "$uuid" ] && [ -f "$f" ] && dconf load "/org/gnome/terminal/legacy/profiles:/:$uuid/" < "$f"
    # wallpaper re-render (the watcher picks the crystal change up too) and live backdrop
    "$HOME/.local/bin/kyberos-wallpaper" >/dev/null 2>&1 || true
    if pgrep -f "kyberos/backdrop/live.qml" >/dev/null; then
        "$HOME/.local/bin/kyberos-live" off >/dev/null; "$HOME/.local/bin/kyberos-live" on >/dev/null
    fi
    [ $quiet = 1 ] || echo "kyber crystal: $Cap ($hex)"
    exit 0
fi

# ---- Plasma ----
w() { kwriteconfig6 "$@"; }
# plasma-apply-* push cursor/colours to XWayland apps via xrdb, which needs X auth
if [ -z "${DISPLAY:-}" ] || [ -z "${XAUTHORITY:-}" ]; then
    # take the session's own values (Xwayland is :0 on some distros, :1 on others)
    sp=$(pgrep -u "$(id -u)" -x plasmashell | head -1 || true)
    [ -n "$sp" ] && while IFS= read -r -d '' kv; do
        case $kv in DISPLAY=*|XAUTHORITY=*) export "$kv" ;; esac
    done < "/proc/$sp/environ"
fi

plasma-apply-colorscheme "KyberOS$Cap" >/dev/null
plasma-apply-cursortheme "KyberOS-$Cap" >/dev/null 2>&1 || true

w --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
w --file kwinrc --group org.kde.kdecoration2 --key theme "__aurorae__svg__KyberOS-$Cap"
w --file kwinrc --group Effect-kyberos_open --key Accent "$hex"
w --file kwinrc --group Effect-kyberos_wipe --key Accent "$hex"

# app widgets
[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/Kvantum/KyberOS-$Cap" ] &&
    w --file "${XDG_CONFIG_HOME:-$HOME/.config}/Kvantum/kvantum.kvconfig" --group General --key theme "KyberOS-$Cap"

# terminal colours
profile=${XDG_DATA_HOME:-$HOME/.local/share}/konsole/KyberOS.profile
[ -f "$profile" ] && w --file "$profile" --group Appearance --key ColorScheme "KyberOS$Cap"

# lock screen wallpaper
w --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kyberos.tactical --group General --key Crystal "$crystal"

# desktop wallpaper (every desktop using the tactical plugin)
gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell --method org.kde.PlasmaShell.evaluateScript "
    desktops().forEach(function (d) {
        if (d.wallpaperPlugin !== 'org.kyberos.tactical') return;
        d.currentConfigGroup = ['Wallpaper', 'org.kyberos.tactical', 'General'];
        d.writeConfig('Crystal', '$crystal');
    });" >/dev/null 2>&1 || true

gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure >/dev/null 2>&1 || true
for e in kyberos_open kyberos_wipe; do
    gdbus call --session --dest org.kde.KWin --object-path /Effects --method org.kde.kwin.Effects.reconfigureEffect "$e" >/dev/null 2>&1 || true
done

[ $quiet = 1 ] || echo "kyber crystal: $Cap ($hex)"
