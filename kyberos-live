#!/usr/bin/env bash
# KyberOS live backdrop for Cinnamon (opt-in, experimental): runs the animated scenes in a
# desktop-layer window on every monitor, under the desktop icons.
#   kyberos-live on|off     enable/disable (autostart entry + start/stop now)
#   kyberos-live run        what the autostart entry runs
set -uo pipefail
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
AUTO=${XDG_CONFIG_HOME:-$HOME/.config}/autostart/kyberos-live.desktop

qml_bin() {
    for q in /usr/lib/qt6/bin/qml /usr/lib64/qt6/bin/qml /usr/bin/qml6 /usr/lib/x86_64-linux-gnu/qt6/bin/qml; do
        [ -x "$q" ] && { echo "$q"; return; }
    done
    command -v qml
}

case ${1:-run} in
on)
    mkdir -p "$(dirname "$AUTO")"
    cp "$DATA/kyberos/autostart/kyberos-live.desktop" "$AUTO"
    pgrep -f "kyberos/backdrop/live.qml" >/dev/null || setsid "$0" run </dev/null >/dev/null 2>&1 &
    echo "live backdrop on"
    ;;
off)
    rm -f "$AUTO"
    pkill -f "kyberos/backdrop/live.qml"
    pkill -f "kyberos-live run"
    echo "live backdrop off"
    ;;
run)
    crystal=$(cat "$DATA/kyberos/crystal" 2>/dev/null || echo blue)
    q=$(qml_bin) || { echo "qml runtime not found" >&2; exit 1; }
    "$q" "$DATA/kyberos/backdrop/live.qml" -- "$crystal" &
    pid=$!
    # turn our windows into desktop-layer windows (bottom of the stack, no taskbar entry)
    for _ in $(seq 1 20); do
        ids=$(xwininfo -root -tree 2>/dev/null | awk '/"kyberos-live"/ {print $1}')
        [ -n "$ids" ] && break
        sleep 0.5
    done
    for id in $ids; do
        xprop -id "$id" -f _NET_WM_WINDOW_TYPE 32a -set _NET_WM_WINDOW_TYPE _NET_WM_WINDOW_TYPE_DESKTOP
    done
    # nemo-desktop refuses to run while another desktop window exists unless that window's
    # class is in its ignore list; then (re)start it so it maps last, above us
    cur=$(gsettings get org.nemo.desktop ignored-desktop-handlers 2>/dev/null || echo "@as []")
    case $cur in
        *"'Qml Runtime'"*) ;;
        "@as []"|"[]") gsettings set org.nemo.desktop ignored-desktop-handlers "['qml', 'Qml Runtime']" ;;
        *) gsettings set org.nemo.desktop ignored-desktop-handlers "${cur%]}, 'qml', 'Qml Runtime']" ;;
    esac
    pkill -x nemo-desktop; sleep 1
    setsid nemo-desktop </dev/null >/dev/null 2>&1 &
    # and lift its window above ours (both are desktop-layer windows)
    for _ in $(seq 1 20); do
        nid=$(for w in $(xprop -root _NET_CLIENT_LIST | grep -o "0x[0-9a-f]*"); do
                  xprop -id "$w" WM_CLASS 2>/dev/null | grep -q '"Nemo-desktop"' && echo "$w"; done | head -1)
        [ -n "$nid" ] && { xdotool windowraise "$nid" 2>/dev/null || true; break; }
        sleep 0.5
    done
    wait $pid
    ;;
*)
    echo "usage: kyberos-live on|off" >&2; exit 2 ;;
esac
